# Copy the values you need into process environment variables. Do not commit keys.
# Exactly 32 random bytes encoded as strict Base64. Production sensitive writes
# fail closed when this variable is absent or malformed.
PAST_PARTNER_MASTER_KEY=

# Master-key source. `auto` keeps environment-first behavior, `environment`
# uses only PAST_PARTNER_MASTER_KEY, `dpapi` is Windows development-only, and
# `kms` stores only a provider-encrypted 32-byte key locally.
PAST_PARTNER_MASTER_KEY_SOURCE=auto
PAST_PARTNER_MASTER_KEY_KMS_KEY_ID=
PAST_PARTNER_MASTER_KEY_KMS_CIPHERTEXT_FILE=
PAST_PARTNER_MASTER_KEY_KMS_REGION=us-east-1
PAST_PARTNER_MASTER_KEY_KMS_ENDPOINT=
PAST_PARTNER_MASTER_KEY_KMS_AUTO_PROVISION=false

# Object-byte storage backend. `local` is the default; `s3` and `minio` require
# the optional requirements-storage.txt profile and explicit server-side config.
# Unknown values fail startup instead of silently writing production data locally.
PAST_PARTNER_STORAGE_BACKEND=local
PAST_PARTNER_STORAGE_S3_ENDPOINT=
PAST_PARTNER_STORAGE_S3_BUCKET=
PAST_PARTNER_STORAGE_S3_REGION=us-east-1
PAST_PARTNER_STORAGE_S3_ACCESS_KEY=
PAST_PARTNER_STORAGE_S3_SECRET_KEY=
PAST_PARTNER_STORAGE_S3_SESSION_TOKEN=
PAST_PARTNER_STORAGE_S3_PATH_STYLE=true

# Encrypted metadata backend. SQLite is the default; PostgreSQL is optional and
# requires the core psycopg dependency plus a server-side DSN. Unknown values
# fail startup instead of silently falling back.
PAST_PARTNER_METADATA_BACKEND=sqlite
# Required only when PAST_PARTNER_METADATA_BACKEND=postgresql (postgres is an alias).
# Keep credentials server-side; never send this value to the web/mobile client.
PAST_PARTNER_METADATA_DSN=
# Bounded PostgreSQL connection pool; values are validated at startup.
PAST_PARTNER_METADATA_POOL_MIN_SIZE=1
PAST_PARTNER_METADATA_POOL_MAX_SIZE=4

PAST_PARTNER_OPENAI_API_KEY=
PAST_PARTNER_OPENAI_BASE_URL=https://api.openai.com/v1
PAST_PARTNER_OPENAI_MODELS=gpt-4.1-mini
PAST_PARTNER_OPENAI_AUDIO_MODELS=
PAST_PARTNER_OPENAI_VIDEO_MODELS=
PAST_PARTNER_OPENAI_VIDEO_ENDPOINT_PATH=
PAST_PARTNER_OPENAI_OCR_MODELS=

PAST_PARTNER_DEEPSEEK_API_KEY=
PAST_PARTNER_DEEPSEEK_BASE_URL=https://api.deepseek.com
PAST_PARTNER_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
PAST_PARTNER_DEEPSEEK_AUDIO_MODELS=
PAST_PARTNER_DEEPSEEK_VIDEO_MODELS=
PAST_PARTNER_DEEPSEEK_VIDEO_ENDPOINT_PATH=
PAST_PARTNER_DEEPSEEK_OCR_MODELS=

PAST_PARTNER_XIAOMI_MIMO_API_KEY=
PAST_PARTNER_XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
PAST_PARTNER_XIAOMI_MIMO_MODELS=mimo-v2.5-pro
PAST_PARTNER_XIAOMI_MIMO_AUDIO_MODELS=
PAST_PARTNER_XIAOMI_MIMO_VIDEO_MODELS=
PAST_PARTNER_XIAOMI_MIMO_VIDEO_ENDPOINT_PATH=
PAST_PARTNER_XIAOMI_MIMO_OCR_MODELS=

PAST_PARTNER_QWEN_API_KEY=
PAST_PARTNER_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PAST_PARTNER_QWEN_MODELS=qwen3.7-plus,qwen3.7-max
PAST_PARTNER_QWEN_AUDIO_MODELS=
PAST_PARTNER_QWEN_VIDEO_MODELS=
PAST_PARTNER_QWEN_VIDEO_ENDPOINT_PATH=
PAST_PARTNER_QWEN_OCR_MODELS=
# Native Model Studio fine-tuning is opt-in. Keep the model list explicit; an
# API key or a normal compatible chat endpoint alone never enables training.
PAST_PARTNER_QWEN_FINE_TUNING_ENABLED=false
PAST_PARTNER_QWEN_FINE_TUNING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
PAST_PARTNER_QWEN_FINE_TUNING_MODELS=
# Explicit external smoke only; it uploads a synthetic example and may incur cost.
PAST_PARTNER_QWEN_FINE_TUNING_SMOKE=
PAST_PARTNER_QWEN_FINE_TUNING_SMOKE_MODEL=

PAST_PARTNER_ANTHROPIC_API_KEY=
PAST_PARTNER_ANTHROPIC_BASE_URL=https://api.anthropic.com
PAST_PARTNER_ANTHROPIC_MODELS=claude-sonnet-4-5

PAST_PARTNER_GEMINI_API_KEY=
PAST_PARTNER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
PAST_PARTNER_GEMINI_MODELS=gemini-2.5-flash

PAST_PARTNER_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
PAST_PARTNER_OLLAMA_MODELS=
PAST_PARTNER_OLLAMA_AUDIO_MODELS=
PAST_PARTNER_OLLAMA_VIDEO_MODELS=
PAST_PARTNER_OLLAMA_VIDEO_ENDPOINT_PATH=
PAST_PARTNER_OLLAMA_OCR_MODELS=

PAST_PARTNER_CUSTOM_OPENAI_BASE_URL=
# Optional for local OpenAI-compatible runtimes that do not require auth.
PAST_PARTNER_CUSTOM_OPENAI_API_KEY=
PAST_PARTNER_CUSTOM_OPENAI_MODELS=
PAST_PARTNER_CUSTOM_OPENAI_AUDIO_MODELS=
PAST_PARTNER_CUSTOM_OPENAI_VIDEO_MODELS=
PAST_PARTNER_CUSTOM_OPENAI_VIDEO_ENDPOINT_PATH=
PAST_PARTNER_CUSTOM_OPENAI_OCR_MODELS=

# Optional provider/admin model pricing and metadata JSON. Keys use provider_id/model_id.
# Prices are input/output USD per 1M tokens unless another currency is supplied.
PAST_PARTNER_MODEL_PRICING_JSON=

# Opt-in real-provider text smoke. Set the flag only for a disposable test
# request; output is redacted and never contains API keys or response text.
PAST_PARTNER_PROVIDER_SMOKE=
PAST_PARTNER_PROVIDER_SMOKE_PROVIDER=deepseek
PAST_PARTNER_PROVIDER_SMOKE_MODEL=
PAST_PARTNER_PROVIDER_SMOKE_PROMPT=

# Optional startup cleanup for stale failed/cancelled raw imports; 0 disables it.
PAST_PARTNER_RAW_RETENTION_SECONDS=0
PAST_PARTNER_NORMALIZED_RETENTION_SECONDS=0

# Optional development-only mobile device pairing. Configure all four values
# together. The token is strict Base64 for at least 32 random bytes; allowed
# networks must be private RFC1918/IPv6 ULA CIDRs (prefer /32 or /128).
# The certificate must contain an IP SAN for PAST_PARTNER_HOST. Never commit
# real token or key material. Pairing binds the short-lived device session to
# the configured token fingerprint and is rejected outside development mode.
PAST_PARTNER_DEV_DEVICE_BOOTSTRAP_TOKEN=
PAST_PARTNER_DEV_DEVICE_ALLOWED_NETWORKS=
PAST_PARTNER_DEV_DEVICE_TLS_CERT_FILE=
PAST_PARTNER_DEV_DEVICE_TLS_KEY_FILE=

# P4-06 durable task queue uses the configured metadata backend and has no
# broker or worker credentials. Start worker processes explicitly in deployment.

# P4-07 local sessions persist owner:read and owner:write scopes. Scope values
# are issued by the server and are not configured as client-side environment data.
# Optional OIDC login. Provide one HTTPS issuer and audience, plus either
# bounded inline JWKS JSON or an HTTPS JWKS URI. Unknown signing keys refresh
# from the URI with a bounded interval; remote discovery and refresh tokens remain later slices.
PAST_PARTNER_OIDC_ISSUER=
PAST_PARTNER_OIDC_AUDIENCE=
PAST_PARTNER_OIDC_JWKS_JSON=
PAST_PARTNER_OIDC_JWKS_URI=

# Android store-release signing is opt-in. Keep the keystore outside Git and
# provide all four values only to the build process; never commit real secrets.
PAST_PARTNER_ANDROID_KEYSTORE_FILE=
PAST_PARTNER_ANDROID_KEYSTORE_PASSWORD=
PAST_PARTNER_ANDROID_KEY_ALIAS=
PAST_PARTNER_ANDROID_KEY_PASSWORD=
# The build helper sets this child-process flag automatically for -StoreRelease.
# PAST_PARTNER_ANDROID_STORE_RELEASE=true
